{
  "name": "minecraft-ai-mod-creator",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "A local-first workbench for creating Minecraft Java mods with ChatGPT, sketches, and editable assets.",
  "scripts": {
    "start": "node server/index.js",
    "start:dev": "node --watch server/index.js",
    "test": "node --test",
    "verify:setup": "node scripts/verify-setup.js",
    "demo:build": "node scripts/build-browser-demo.mjs",
    "css:build": "tailwindcss -i public/tailwind.input.css -o public/tailwind.css --minify",
    "dist:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
}
