{
  "name": "modpack-werkstatt",
  "version": "0.3.9",
  "description": "A Windows desktop studio for planning Minecraft modpacks.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-all.cjs",
    "dist": "electron-builder --win portable --x64",
    "predist": "node scripts/verify-mod-studio.cjs",
    "studio:sync": "node scripts/sync-mod-studio.cjs"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.25.0",
    "playwright": "^1.64.0"
  },
  "build": {
    "appId": "de.modpackwerkstatt.app",
    "productName": "Modspire",
    "files": [
      "main.cjs",
      "preload.cjs",
      "mrpack.cjs",
      "catalog-search.cjs",
      "design-manager.cjs",
      "v3-ui.js",
      "v4-ui.js",
      "renderer.js",
      "pack-tools.js",
      "pack-bookmarks.cjs",
      "pack-release.cjs",
      "pack-curseforge.cjs",
      "pack-library.js",
      "pack-library.css",
      "pack-dependencies.js",
      "pack-workflows.js",
      "pack-workflows.css",
      "ui-refresh.css",
      "chat-refresh.css",
      "wallpaper-fx.css",
      "surfaces.css",
      "sidebar.css",
      "picker-refresh.css",
      "design-dialog.css",
      "clarity.css",
      "wallpaper-fx.js",
      "contrast-guard.js",
      "chat-tone.js",
      "glass-ui.css",
      "glass-ui.js",
      "design-quick.js",
      "modern-ui.js",
      "i18n.js",
      "diagnostics.cjs",
      "setup-discovery.cjs",
      "updater.cjs",
      "weekly-favorites.cjs",
      "ollama-stream.cjs",
      "diagnostics-ui.js",
      "index.html",
      "styles.css",
      "desktop-polish.css",
      "desktop-polish.js",
      "visual-fixes.css",
      "modern-ui.css",
      "v3-ui.css",
      "v4-ui.css",
      "assets/**/*",
      "package.json",
      "vendor/**/*",
      "!vendor/siwc-runtime.mjs",
      "!assets/shader-*.png",
      "!assets/brand/**",
      "local-web.cjs",
      "web-bridge.js",
      "web-bootstrap.js",
      "local-web-ui.js",
      "local-web.css",
      "opencode.cjs",
      "mod-studio.cjs",
      "mod-studio-worker.cjs",
      "mod-studio-runtime.cjs"
    ],
    "win": {
      "icon": "assets/modspire.ico",
      "target": [
        "portable"
      ],
      "artifactName": "Modspire-${version}-Portable.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "integrations/mod-studio",
        "to": "mod-studio"
      },
      {
        "from": ".mod-studio-runtime",
        "to": "mod-studio/runtime",
        "filter": [
          "*.zip"
        ]
      }
    ]
  },
  "author": "Modspire contributors",
  "license": "MIT"
}
